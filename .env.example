# ==============================================================================
# AI-GovInsight (Non-AI MVP) Environment Configuration
# ==============================================================================

PROJECT_NAME="AI-GovInsight"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://mk@localhost:5432/aigovinsight"

# Security & JWT Tokens
SECRET_KEY="govinsight-secret-key-change-in-production-civic-tn-secure-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development Flags
MOCK_OTP_ENABLED=true
AI_ENABLED=false

# File Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp", "pdf"]

# SLA Engine Configuration
SLA_CHECK_INTERVAL_SECONDS=300
SLA_WARNING_PERCENTAGE=70
SLA_ESCALATION_LEVEL_2_HOURS=24

# CORS Settings (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
